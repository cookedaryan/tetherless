<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every suppression here is scoped to a class and method and carries the reason it is safe. A
  blanket pattern exclusion silently covers future code the author never considered, which for a
  security detector is how a real finding gets lost.

  This file used to say that and not do it. Two pattern-wide exclusions sat below the comment,
  which is how a genuine DM_DEFAULT_ENCODING hit went unseen: the relay was encoding an ID_TAKEN
  wire payload with the platform default charset, while the suppression's own justification claimed
  the only remaining hits were log and console output. The OBJECT_DESERIALIZATION exclusion,
  meanwhile, was suppressing nothing at all - the detector reports no findings without it. Both are
  gone rather than narrowed; a suppression that covers nothing is not scoped, it is dead.
-->
<FindBugsFilter>

    <!--
      The path here is the operator's own KEYSTORE_PASSWORD_FILE, read from the environment, a JVM
      property, or server.properties. It is deployment configuration, not input from a user or a
      peer, and anyone able to set it already controls the process this code runs in. Reading a
      secret from a file rather than an environment variable is the point of the method: the
      environment is visible to `docker inspect` and inherited by child processes.
    -->
    <Match>
        <Class name="com.e2eechat.server.ServerConfig" />
        <Method name="readPasswordFile" />
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>

</FindBugsFilter>
