.gradle/
build/
# ...but not a Java package that happens to be named "build". core-shared has
# com.e2eechat.core.build, so the line above was quietly excluding BuildInfo.java - hand-written
# source, not build output - and a clean clone of this repository did not compile without it.
!**/src/**/build/
.idea/
*.iml
local.properties
*.db
*.jks
*.p12

# Runtime logs - regenerated on every run, never source
logs/
*.log

# Stray compiled classes from ad-hoc javac runs
*.class
